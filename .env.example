# 複製成 .env 後填入你自己的資料：cp .env.example .env
# .env 已列在 .gitignore，絕對不要 commit 或截圖外流。

# 登入方式：password（帳密＋憑證，預設）或 apikey（SDK >= v2.2.7，選用）
FUBON_LOGIN_MODE=password

# 身分證字號
FUBON_ID=your_personal_id_here
# 電子平台登入密碼（password 模式）
FUBON_PASSWORD=your_login_password_here
# API Key（apikey 模式；於官方「金鑰申請及管理」頁申請）
FUBON_API_KEY=your_api_key_here

# 憑證檔路徑（建議放在 repo 外，或放在已被 .gitignore 的 certs/）
FUBON_CERT_PATH=certs/your_cert_file.pfx
# 憑證密碼；若使用「預設密碼」憑證，password 模式可留空（官方：SDK v1.3.2 以上）
FUBON_CERT_PASSWORD=your_cert_password_here

# 多帳號歸戶時指定期貨帳號（選填）
FUBON_ACCOUNT=

# 行情設定（選填）
FUBON_WS_SYMBOL=TXF1!
FUBON_WS_SYMBOLS=TXF1!,MXF1!
FUBON_AFTER_HOURS=0
FUBON_REALTIME_MODE=speed

# 真實送單開關：除非你完全了解風險，否則請保持空白。
# 04 / 06 範例需此值＝I_UNDERSTAND_THE_RISK，且命令列加 --live、再手動輸入確認，才會送出真實委託。
FUBON_LIVE_ORDER=
